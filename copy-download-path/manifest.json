{
  "manifest_version": 3,
  "name": "Copy Download Path",
  "version": "1.1",
  "description": "When a download finishes, click to copy its full file path instead of opening the file manager.",
  "permissions": [
    "downloads",
    "downloads.open",
    "notifications",
    "offscreen",
    "clipboardWrite",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Recent downloads - copy path",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "copy-last": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Copy path of the last finished download"
    }
  },
  "key": ""
}
