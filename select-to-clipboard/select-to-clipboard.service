[Unit]
Description=Copy-on-select: text selected in OpenCode desktop also goes to the clipboard (Ctrl+V)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 @DIR@/select_to_clipboard.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
