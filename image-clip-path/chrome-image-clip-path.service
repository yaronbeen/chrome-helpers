[Unit]
Description=Copied Chrome images -> saved file; clipboard keeps image (Ctrl+V) and path (Ctrl+Shift+V); deleted after 24h
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 @DIR@/clip_image_path.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
